# MAJBURIY: backend qayerda joylashgan bo'lsa, uning TO'LIQ manzili.
# Backend endi ALOHIDA serverda joylashgani uchun, bo'sh qoldirib bo'lmaydi.
#
# Misollar:
#   VITE_API_URL=https://api.chemlab.uz
#   VITE_API_URL=http://164.90.123.45:8000
VITE_API_URL=https://sizning-backend-domeningiz.uz

# Eslatma: backend tomonida ham (backend/.env) CORS_ALLOWED_ORIGINS
# shu frontend joylashgan manzilni o'z ichiga olishi shart — aks holda
# brauzer so'rovlarni CORS xatosi bilan bloklaydi.
